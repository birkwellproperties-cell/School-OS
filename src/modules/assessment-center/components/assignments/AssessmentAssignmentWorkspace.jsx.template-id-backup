            />

            <DetailField
              icon={
                Clock3
              }
              label="Due"
              value={formatDateTime(
                assignment.due_at,
              )}
            />

            <DetailField
              icon={
                CheckCircle2
              }
              label="Closes"
              value={formatDateTime(
                assignment.closes_at,
              )}
            />
