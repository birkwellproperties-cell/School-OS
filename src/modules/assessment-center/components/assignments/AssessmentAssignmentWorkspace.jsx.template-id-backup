            assignment.status
          }
        />
      </div>

      <div className="mt-4 grid gap-2 text-xs text-slate-600 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <span className="flex items-center gap-2">
          <CalendarClock
            className="h-3.5 w-3.5 text-slate-400"
            aria-hidden="true"
          />

          <span className="truncate">
            Due{" "}
            {formatDateTime(
              assignment.due_at,
            )}
          </span>
        </span>

        <span className="flex items-center gap-2">
          <Monitor
            className="h-3.5 w-3.5 text-slate-400"
            aria-hidden="true"
          />

          <span className="truncate">
            {humanizeValue(
